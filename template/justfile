# __NAME__ — enter the repo through just. Package recipes come from packages/monomono; add yours below.
# Recipe bodies call scripts/build, scripts/tools, or scripts/update. A script is <name>.sh or <name>.lua. No logic here.

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import 'packages/monomono/mono.just'

# scripts/build/<target>.{sh,lua} (for steps buck2 cannot own yet)
[positional-arguments]
build-script target *args:
    @"{{mono_home}}/scripts/tools/run-script.sh" build "$@"

# scripts/tools/<name>.{sh,lua}
[positional-arguments]
tool name *args:
    @"{{mono_home}}/scripts/tools/run-script.sh" tools "$@"

# scripts/update/<target>.{sh,lua}
[positional-arguments]
update target *args:
    @"{{mono_home}}/scripts/tools/run-script.sh" update "$@"
