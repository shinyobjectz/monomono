#!/usr/bin/env bash
# Bootstrap. Attaches monomono to a repo as packages/monomono and scaffolds the skeleton.
#
#   curl -fsSL https://raw.githubusercontent.com/shinyobjectz/monomono/main/bin/monomono | bash -s -- init
#   monomono init [dir] [--ref v0.1.0] [--repo <url>] [--vendor] [--name <repo-name>] [--provider <app>] [--no-context]
#   monomono version                 # bootstrap version
#   monomono upgrade                 # update the bootstrap checkout and buck2
#   monomono doctor                  # host tools present?
#
# After init, everything else is `just`. This file has no dependency on the rest of the package
# so it can run before the package is present.

set -euo pipefail

REPO="${MONO_REPO_URL:-https://github.com/shinyobjectz/monomono}"
REF=""
MODE="submodule"
NAME=""
TARGET=""

usage() {
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

latest_tag() {
  git ls-remote --tags --refs "$1" 2>/dev/null | awk -F/ '{print $NF}' | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1
}

cmd_init() {
  EXTRA=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ref) REF=$2; shift 2 ;;
      --repo) REPO=$2; shift 2 ;;
      --vendor) MODE="vendor"; shift ;;
      --name) NAME=$2; shift 2 ;;
      --provider) EXTRA+=(--provider "$2"); shift 2 ;;
      --no-context) EXTRA+=(--no-context); shift ;;
      -h|--help) usage ;;
      -*) echo "unknown flag: $1" >&2; usage ;;
      *) TARGET=$1; shift ;;
    esac
  done
  TARGET=${TARGET:-.}
  mkdir -p "$TARGET"
  TARGET=$(cd "$TARGET" && pwd)
  command -v git >/dev/null 2>&1 || { echo "git is required" >&2; exit 1; }

  if [[ ! -d $TARGET/.git ]]; then
    git -C "$TARGET" init -q
    echo "initialized git repo at $TARGET"
  fi

  if [[ -f $TARGET/packages/monomono/VERSION ]]; then
    echo "packages/monomono already present ($(cat "$TARGET/packages/monomono/VERSION")); running scaffold only"
  else
    [[ -n $REF ]] || REF=$(latest_tag "$REPO")
    [[ -n $REF ]] || REF="main"
    mkdir -p "$TARGET/packages"
    case "$MODE" in
      submodule)
        git -C "$TARGET" -c protocol.file.allow=always submodule add --name monomono "$REPO" packages/monomono
        git -C "$TARGET/packages/monomono" fetch -q --tags origin
        git -C "$TARGET/packages/monomono" checkout -q "$REF"
        ;;
      vendor)
        git -c protocol.file.allow=always clone -q "$REPO" "$TARGET/packages/monomono"
        git -C "$TARGET/packages/monomono" checkout -q "$REF"
        rm -rf "$TARGET/packages/monomono/.git"
        ;;
    esac
    echo "attached monomono $REF as packages/monomono ($MODE)"
  fi

  MONO_HOME="$TARGET/packages/monomono" MONO_ROOT="$TARGET" \
    "$TARGET/packages/monomono/scripts/tools/mono.sh" init --mode "$MODE" --repo "$REPO" ${NAME:+--name "$NAME"} ${EXTRA[@]+"${EXTRA[@]}"}
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  version)
    here="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
    [[ -f $here/VERSION ]] && cat "$here/VERSION" || echo "remote"
    ;;
  upgrade)
    curl -fsSL "${MONO_REPO_URL:-https://github.com/shinyobjectz/monomono}/raw/main/install.sh" | bash
    ;;
  doctor)
    for t in git just buck2 sqlite3; do
      if command -v "$t" >/dev/null 2>&1; then echo "ok    $t $($t --version 2>/dev/null | head -n 1 | cut -c1-50)"; else echo "miss  $t"; fi
    done
    ;;
  *) usage ;;
esac
